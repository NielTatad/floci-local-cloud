# =============================================================================
# Floci Local Cloud — Environment Variables
#
# Copy this file to floci/.env and adjust as needed.
# The .env file is excluded from Git. Never commit real credentials here.
#
# Usage:
#   cp floci/.env.example floci/.env
#   # edit floci/.env
#   make up
# =============================================================================

# -----------------------------------------------------------------------------
# Docker image
# Pin to a specific release for reproducible builds.
# See available tags: https://hub.docker.com/r/floci/floci/tags
# -----------------------------------------------------------------------------
FLOCI_VERSION=2.5.0

# Docker container name (must be unique on the Docker host)
FLOCI_CONTAINER_NAME=floci

# Docker volume name for persistent state
FLOCI_VOLUME_NAME=floci-data

# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------

# Host port that maps to Floci's internal port 4566
FLOCI_HOST_PORT=4566

# Hostname Floci uses when constructing returned URLs (e.g. SQS QueueUrl).
# Set to the Docker Compose service name so other containers can resolve it.
FLOCI_HOSTNAME=floci

# -----------------------------------------------------------------------------
# Storage
# memory     — fastest; all state lost on container stop (good for CI)
# persistent — write-through to disk on every mutation
# hybrid     — in-memory + async flush every 5 s (recommended for local dev)
# wal        — write-ahead log; highest durability
# -----------------------------------------------------------------------------
FLOCI_STORAGE_MODE=hybrid

# -----------------------------------------------------------------------------
# AWS defaults
# Any non-empty string is accepted as credentials unless auth enforcement is on.
# Never use real AWS credentials here.
# -----------------------------------------------------------------------------
FLOCI_DEFAULT_REGION=us-east-1
FLOCI_DEFAULT_ACCOUNT_ID=000000000000

# -----------------------------------------------------------------------------
# Auth enforcement (optional hardening)
# FLOCI_SERVICES_S3_ENFORCE_AUTH=false
#   false — accept any non-empty credential for S3 (default)
#   true  — reject S3 requests signed with unknown access keys
#
# FLOCI_NETWORK_SECURITY_GROUP_ENFORCEMENT_ENABLED=false
#   true  — apply nftables security-group rules to Docker-backed services
#          (requires rootful Docker running Linux containers)
# -----------------------------------------------------------------------------
FLOCI_SERVICES_S3_ENFORCE_AUTH=false
FLOCI_NETWORK_SECURITY_GROUP_ENFORCEMENT_ENABLED=false

# -----------------------------------------------------------------------------
# Web console sidecar (browser UI at http://localhost:4500)
# The sidecar image is pulled on first visit; set to false to disable entirely.
# -----------------------------------------------------------------------------
FLOCI_SERVICES_UI_ENABLED=true
